-- ==============================================================================
-- SUPABASE POSTGRESQL (PSQL) DATABASE SCHEMA & SEED DATA
-- Project: MIS (Management Information System)
-- Description: Page-wise modular PostgreSQL DDL & DML for Supabase
-- ==============================================================================

-- Enable UUID extension if not already enabled
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ==============================================================================
-- 1. GLOBAL / BASE TABLES (Companies / Tenants & Departments)
-- ==============================================================================

-- Tenants / Companies (For multi-company / tenant support)
CREATE TABLE IF NOT EXISTS tenants (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name VARCHAR(255) NOT NULL,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Departments
CREATE TABLE IF NOT EXISTS departments (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    tenant_id UUID REFERENCES tenants(id) ON DELETE CASCADE,
    name VARCHAR(150) NOT NULL UNIQUE,
    employee_count INT DEFAULT 0,
    average_score NUMERIC(5, 2) DEFAULT 0.00,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Employees / Users Table
CREATE TABLE IF NOT EXISTS employees (
    id VARCHAR(50) PRIMARY KEY, -- e.g. 'emp-001' or UUID string
    tenant_id UUID REFERENCES tenants(id) ON DELETE SET NULL,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    image TEXT,
    department VARCHAR(150) NOT NULL,
    designation VARCHAR(150) NOT NULL,
    score NUMERIC(5, 2) DEFAULT 0.00,
    total_tasks INT DEFAULT 0,
    completed_tasks INT DEFAULT 0,
    pending_tasks INT DEFAULT 0,
    target NUMERIC(5, 2) DEFAULT 100.00,
    actual_work_done NUMERIC(5, 2) DEFAULT 0.00,
    weekly_work_done NUMERIC(5, 2) DEFAULT 0.00,
    weekly_work_done_on_time NUMERIC(5, 2) DEFAULT 0.00,
    total_work_done NUMERIC(5, 2) DEFAULT 0.00,
    week_pending INT DEFAULT 0,
    all_pending_till_date INT DEFAULT 0,
    planned_work_not_done INT DEFAULT 0,
    planned_work_not_done_on_time INT DEFAULT 0,
    commitment NUMERIC(5, 2) DEFAULT 0.00,
    next_week_planned_work_not_done INT DEFAULT 0,
    next_week_planned_work_not_done_on_time INT DEFAULT 0,
    next_week_commitment NUMERIC(5, 2) DEFAULT 0.00,
    weekly_commitment NUMERIC(5, 2) DEFAULT 0.00,
    date_start DATE,
    date_end DATE,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_employees_department ON employees(department);
CREATE INDEX IF NOT EXISTS idx_employees_designation ON employees(designation);


-- ==============================================================================
-- 2. PAGE: DASHBOARD (/mis/dashboard)
-- ==============================================================================
-- Dashboard uses:
-- 1) `employees` table (detailed performance metrics)
-- 2) `department_stats` view/table (summary cards, pending totals, score charts)
-- 3) Auto-submit / Dashboard settings

CREATE TABLE IF NOT EXISTS mis_auto_submit_settings (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    tenant_id UUID REFERENCES tenants(id) ON DELETE CASCADE,
    enabled BOOLEAN DEFAULT FALSE,
    day_of_week INT DEFAULT 6, -- 6 = Saturday
    time_of_day TIME DEFAULT '20:00:00',
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Realtime Department Stats Aggregation View for Dashboard
CREATE OR REPLACE VIEW view_department_stats AS
SELECT 
    d.id,
    d.name,
    COUNT(e.id) AS employee_count,
    COALESCE(ROUND(AVG(e.score), 2), 0) AS average_score,
    COALESCE(SUM(e.pending_tasks), 0) AS pending_works,
    COALESCE(SUM(e.all_pending_till_date), 0) AS all_pending,
    COALESCE(ROUND(AVG(e.planned_work_not_done), 2), 0) AS work_not_done_pct,
    COALESCE(ROUND(AVG(e.planned_work_not_done_on_time), 2), 0) AS not_done_on_time_pct,
    d.tenant_id
FROM departments d
LEFT JOIN employees e ON LOWER(e.department) = LOWER(d.name)
GROUP BY d.id, d.name, d.tenant_id;


-- ==============================================================================
-- 3. PAGE: TODAY'S TASKS (/mis/today_tasks)
-- ==============================================================================
-- Structured table replacing the Google Sheets (Master, Data, For Records)

CREATE TABLE IF NOT EXISTS today_tasks (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    fms_name VARCHAR(255) NOT NULL, -- e.g. 'Project Alpha', 'Sales Lead'
    task_name VARCHAR(255) NOT NULL,
    person_name VARCHAR(255) NOT NULL,
    employee_id VARCHAR(50) REFERENCES employees(id) ON DELETE SET NULL,
    task_date DATE DEFAULT CURRENT_DATE,
    planned VARCHAR(100), -- planned target/count
    actual VARCHAR(100),  -- actual achievement
    delay VARCHAR(100),   -- delay metrics
    status VARCHAR(50) DEFAULT 'pending', -- 'pending', 'completed', 'delayed'
    remarks TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_today_tasks_date ON today_tasks(task_date);
CREATE INDEX IF NOT EXISTS idx_today_tasks_person ON today_tasks(person_name);


-- ==============================================================================
-- 4. PAGE: PENDING TASKS (/mis/pending_tasks) & GENERAL TASKS
-- ==============================================================================

CREATE TABLE IF NOT EXISTS tasks (
    id VARCHAR(50) PRIMARY KEY, -- e.g. 'task-001' or UUID
    fms_name VARCHAR(255) NOT NULL,
    task_name VARCHAR(255) NOT NULL,
    person_name VARCHAR(255) NOT NULL,
    description TEXT,
    assigned_to VARCHAR(50) REFERENCES employees(id) ON DELETE CASCADE,
    due_date DATE NOT NULL,
    status VARCHAR(50) DEFAULT 'pending', -- 'pending' | 'in-progress' | 'completed'
    priority VARCHAR(50) DEFAULT 'medium', -- 'low' | 'medium' | 'high'
    target NUMERIC(5, 2) DEFAULT 100.00,
    actual_achievement NUMERIC(5, 2) DEFAULT 0.00,
    work_not_done INT DEFAULT 0,
    work_not_done_on_time INT DEFAULT 0,
    all_pending_till_date INT DEFAULT 0,
    today_task VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_tasks_status ON tasks(status);
CREATE INDEX IF NOT EXISTS idx_tasks_assigned_to ON tasks(assigned_to);
CREATE INDEX IF NOT EXISTS idx_tasks_due_date ON tasks(due_date);


-- ==============================================================================
-- 5. PAGE: COMMITMENT HISTORY (/mis/history_commitment)
-- ==============================================================================
-- Stores weekly snapshot of employee commitments submitted manually or by auto-trigger

CREATE TABLE IF NOT EXISTS commitment_history (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    employee_id VARCHAR(50) REFERENCES employees(id) ON DELETE CASCADE,
    tenant_id UUID REFERENCES tenants(id) ON DELETE SET NULL,
    name VARCHAR(255) NOT NULL,
    department VARCHAR(150) NOT NULL,
    target NUMERIC(5, 2) DEFAULT 100.00,
    score NUMERIC(5, 2) DEFAULT 0.00,
    actual_work_done NUMERIC(5, 2),
    weekly_work_done NUMERIC(5, 2),
    weekly_work_done_on_time NUMERIC(5, 2),
    total_work_done NUMERIC(5, 2),
    week_pending INT,
    all_pending_till_date INT,
    commitment VARCHAR(50) NOT NULL,
    next_week_planned_work_not_done INT DEFAULT 0,
    next_week_planned_work_not_done_on_time INT DEFAULT 0,
    date_start DATE NOT NULL,
    date_end DATE NOT NULL,
    submitted_at TIMESTAMPTZ DEFAULT NOW(),
    source VARCHAR(20) DEFAULT 'MANUAL' -- 'MANUAL' | 'AUTO'
);

CREATE INDEX IF NOT EXISTS idx_commitment_history_employee ON commitment_history(employee_id);
CREATE INDEX IF NOT EXISTS idx_commitment_history_dates ON commitment_history(date_start, date_end);


-- ==============================================================================
-- 6. PAGE: KPI / KRA (/mis/kpi_kra)
-- ==============================================================================
-- Stores designation level benchmarks, SOPs, training materials & communication rules

CREATE TABLE IF NOT EXISTS kpi_kra_designations (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    designation VARCHAR(150) NOT NULL UNIQUE, -- 'CRM', 'PURCHASE', 'HR', etc.
    actual_role TEXT,
    total_tasks VARCHAR(100),
    scoring_works TEXT, -- Video URL or Guide URL
    score_better TEXT,  -- Video URL or Guide URL
    key_person VARCHAR(255),
    communication_team TEXT[], -- Array of roles/teams e.g. ARRAY['Sales', 'Tech']
    how_to_communicate TEXT,
    importance_score VARCHAR(100),
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Related Systems / Software Tools under each KPI/KRA Designation
CREATE TABLE IF NOT EXISTS kpi_kra_systems (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    designation_id UUID REFERENCES kpi_kra_designations(id) ON DELETE CASCADE,
    system_name VARCHAR(255) NOT NULL,
    task_name VARCHAR(255) NOT NULL,
    description TEXT,
    system_link TEXT,
    db_link TEXT,
    training_video TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_kpi_kra_systems_designation ON kpi_kra_systems(designation_id);


-- ==============================================================================
-- 7. PAGE: DEPARTMENT REPORT (/mis/department)
-- ==============================================================================
-- Department Report aggregates task performance across all departments.
-- Can be queried directly with the following view:

CREATE OR REPLACE VIEW view_department_report AS
SELECT 
    t.id AS task_id,
    t.fms_name,
    t.task_name,
    t.description,
    e.id AS employee_id,
    e.name AS employee_name,
    e.image AS employee_image,
    e.department,
    e.designation,
    t.due_date,
    t.status,
    t.priority,
    COALESCE(e.target, 100) AS target,
    COALESCE(e.actual_work_done, 0) AS total_achievement,
    COALESCE(e.total_work_done, 0) AS work_done_percentage,
    COALESCE(e.weekly_work_done_on_time, 0) AS work_done_on_time_percentage,
    COALESCE(e.all_pending_till_date, 0) AS all_pending_till_date
FROM tasks t
JOIN employees e ON t.assigned_to = e.id;


