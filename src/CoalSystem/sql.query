);
CREATE TABLE public.employee (
  id integer NOT NULL DEFAULT nextval('employee_id_seq'::regclass),
  name character varying NOT NULL,
  salary numeric DEFAULT 0,
  CONSTRAINT employee_pkey PRIMARY KEY (id)
);
CREATE TABLE public.inventory_items (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  item_code character varying NOT NULL UNIQUE,
  category character varying NOT NULL,
  item_name character varying NOT NULL,
  unit character varying NOT NULL,
  opening_qty numeric DEFAULT 0,
  current_stock numeric DEFAULT 0,
  status character varying NOT NULL DEFAULT 'In Stock'::character varying CHECK (status::text = ANY (ARRAY['In Stock'::character varying, 'Low Stock'::character varying, 'Out of Stock'::character varying]::text[])),
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT inventory_items_pkey PRIMARY KEY (id)
);
CREATE TABLE public.attendance (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  employee_id integer NOT NULL,
  attendance_date date NOT NULL,
  check_in timestamp with time zone,
  check_out timestamp with time zone,
  working_hours text,
  attendance_type text,
  latitude numeric,
  longitude numeric,
  address text,
  image text,
  device_info text,
  remarks text,
  status text,
  created_at timestamp with time zone DEFAULT now(),
  employee_name text,
  CONSTRAINT attendance_pkey PRIMARY KEY (id)
);
CREATE TABLE public.petty_cash_addcash_credits (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  sn text UNIQUE,
  person_name text NOT NULL,
  date date NOT NULL,
  amount numeric NOT NULL CHECK (amount > 0::numeric),
  payment_mode text,
  particulars text DEFAULT 'CASH'::text,
  remarks text,
  receipt_url text,
  status text DEFAULT 'APPROVED'::text,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT petty_cash_addcash_credits_pkey PRIMARY KEY (id)
);
CREATE TABLE public.petty_cash_expenses (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  sn text UNIQUE,
  person_name text NOT NULL,
  particulars text,
  date date NOT NULL,
  received numeric DEFAULT 0,
  amount numeric NOT NULL CHECK (amount > 0::numeric),
  balance numeric DEFAULT 0,
  payment_mode text,
  group_head text,
  remarks text,
  receipt_url text,
  status text NOT NULL DEFAULT 'PENDING'::text CHECK (status = ANY (ARRAY['PENDING'::text, 'APPROVED'::text, 'REJECTED'::text])),
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT petty_cash_expenses_pkey PRIMARY KEY (id)
);
CREATE TABLE public.petty_cash_setting (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  group_head text,
  payment_mode text,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT petty_cash_setting_pkey PRIMARY KEY (id)
);
CREATE TABLE public.help_slips (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  name text NOT NULL,
  department text,
  number text,
  challenge text NOT NULL,
  solution1 text NOT NULL,
  solution2 text,
  solution3 text,
  admin_reply text,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT help_slips_pkey PRIMARY KEY (id)
);
CREATE TABLE public.tasks (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  description text,
  date date NOT NULL,
  start_time time without time zone,
  end_time time without time zone,
  status text DEFAULT 'Pending'::text CHECK (status = ANY (ARRAY['Pending'::text, 'In Progress'::text, 'Completed'::text, 'Not Done'::text, 'Overdue'::text])),
  assigned_staff bigint,
  created_by text,
  actual_done_date timestamp with time zone,
  created_at timestamp with time zone DEFAULT now(),
  remark text,
  attachments text,
  color text,
  CONSTRAINT tasks_pkey PRIMARY KEY (id),
  CONSTRAINT tasks_assigned_staff_fkey FOREIGN KEY (assigned_staff) REFERENCES public.users(id)
);
CREATE TABLE public.someday_tasks (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  title text NOT NULL,
  description text,
  priority text DEFAULT 'Medium'::text,
  category text,
  assigned_staff bigint,
  created_by text,
  created_date date,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT someday_tasks_pkey PRIMARY KEY (id),
  CONSTRAINT someday_tasks_assigned_staff_fkey FOREIGN KEY (assigned_staff) REFERENCES public.users(id)
);
CREATE TABLE public.sales_orders (
