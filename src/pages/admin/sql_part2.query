CREATE TABLE public.employee_master (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  name text NOT NULL UNIQUE,
  basic_salary numeric DEFAULT 0,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT employee_master_pkey PRIMARY KEY (id)
);
CREATE TABLE public.transaction_types (
  id character varying NOT NULL,
  display_name character varying NOT NULL UNIQUE,
  created_at timestamp with time zone DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT transaction_types_pkey PRIMARY KEY (id)
);
CREATE TABLE public.inventory_transactions (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  serial_no character varying UNIQUE,
  transaction_type character varying NOT NULL,
  item_code character varying NOT NULL,
  item_name character varying NOT NULL,
  category character varying,
  brand character varying,
  unit_price numeric NOT NULL DEFAULT 0.00 CHECK (unit_price >= 0::numeric),
  qty integer NOT NULL CHECK (qty > 0),
  total_price numeric NOT NULL DEFAULT 0.00,
  remarks text,
  planned_date date,
  actual_date date,
  created_at timestamp with time zone DEFAULT CURRENT_TIMESTAMP,
  updated_at timestamp with time zone DEFAULT CURRENT_TIMESTAMP,
  vendor_name character varying,
  CONSTRAINT inventory_transactions_pkey PRIMARY KEY (id),
  CONSTRAINT inventory_transactions_transaction_type_fkey FOREIGN KEY (transaction_type) REFERENCES public.transaction_types(id)
);
CREATE TABLE public.inventory_summary (
  item_code character varying NOT NULL,
  item_name character varying NOT NULL,
  category character varying,
  brand character varying,
  opening_qty numeric NOT NULL DEFAULT 0,
  purchase_qty numeric NOT NULL DEFAULT 0,
  sales_qty numeric NOT NULL DEFAULT 0,
  purchase_return_qty numeric NOT NULL DEFAULT 0,
  sales_return_qty numeric NOT NULL DEFAULT 0,
  closing_qty numeric NOT NULL DEFAULT 0,
  created_at timestamp with time zone DEFAULT CURRENT_TIMESTAMP,
  updated_at timestamp with time zone DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT inventory_summary_pkey PRIMARY KEY (item_code)
);
CREATE TABLE public.invoice (
  id text NOT NULL,
  invoice_no text NOT NULL UNIQUE,
  customer_name text,
  date date,
  status text DEFAULT 'Active'::text,
  payment_status text DEFAULT '-'::text,
  details jsonb NOT NULL DEFAULT '{}'::jsonb,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  customer_address text,
  customer_area_pin_code text,
  customer_city_state text,
  customer_state text,
  customer_email text,
  customer_mobile text,
  validity_date text,
  price_list text,
  payment_terms text,
  gross_amount numeric DEFAULT 0,
  discount_amount numeric DEFAULT 0,
  tax_amount numeric DEFAULT 0,
  round_off_amount numeric DEFAULT 0,
  total_amount numeric DEFAULT 0,
  item_code text,
  item_description text,
  item_quantity numeric DEFAULT 0,
  item_unit_price numeric DEFAULT 0,
  item_discount_percent numeric DEFAULT 0,
  item_tax_percent numeric DEFAULT 0,
  item_net_amount numeric DEFAULT 0,
  item_add_discount numeric DEFAULT 0,
  CONSTRAINT invoice_pkey PRIMARY KEY (id)
);
CREATE TABLE public.scales_return (
  id text NOT NULL,
  return_no text NOT NULL UNIQUE,
  customer_name text,
  date date,
  status text DEFAULT 'Active'::text,
  details jsonb NOT NULL DEFAULT '{}'::jsonb,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  customer_address text,
  customer_area_pin_code text,
  customer_city_state text,
  customer_state text,
  customer_email text,
  customer_mobile text,
  validity_date text,
  price_list text,
  payment_terms text,
  internal_notes text,
  remarks text,
  terms_conditions text,
  gross_amount numeric DEFAULT 0,
  discount_amount numeric DEFAULT 0,
  tax_amount numeric DEFAULT 0,
  round_off_amount numeric DEFAULT 0,
  total_amount numeric DEFAULT 0,
  ref_invoice text,
  item_code text,
  item_description text,
  item_quantity numeric DEFAULT 0,
  item_unit_price numeric DEFAULT 0,
  item_discount_percent numeric DEFAULT 0,
  item_tax_percent numeric DEFAULT 0,
  item_net_amount numeric DEFAULT 0,
  item_add_discount numeric DEFAULT 0,
  CONSTRAINT scales_return_pkey PRIMARY KEY (id)
);
CREATE TABLE public.customer (
  id text NOT NULL,
  name text NOT NULL,
  title text,
  first_name text,
  last_name text,
  mobile text,
  company text,
  sales_person text,
  gstin text,
  gst_treatment text,
  pan text,
  gst_type text,
  address text,
  price_list text,
  area_pin_code text,
  city_state text,
  email text,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  sales_no text,
  quort_person text,
  quort_mobile_number text,
  CONSTRAINT customer_pkey PRIMARY KEY (id)
);
CREATE TABLE public.vendor (
  id text NOT NULL,
  name text NOT NULL,
  title text,
  first_name text,
  last_name text,
  mobile text,
  company text,
  sales_person text,
  gstin text,
  gst_treatment text,
  pan text,
  gst_type text,
  address text,
  price_list text,
  area_pin_code text,
  city_state text,
  email text,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT vendor_pkey PRIMARY KEY (id)
);
CREATE TABLE public.purchase_return (
  id text NOT NULL,
  return_no text NOT NULL UNIQUE,
  vendor_name text,
  date date,
  status text DEFAULT 'Active'::text,
  details jsonb NOT NULL DEFAULT '{}'::jsonb,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  vendor_address text,
  vendor_area_pin_code text,
  vendor_city_state text,
  vendor_state text,
  vendor_email text,
  vendor_mobile text,
  validity_date text,
  price_list text,
  payment_terms text,
  internal_notes text,
  remarks text,
  terms_conditions text,
  gross_amount numeric,
  discount_amount numeric,
  tax_amount numeric,
  round_off_amount numeric,
  total_amount numeric,
  ref_purchase text,
  items jsonb,
  item_code text,
  item_description text,
  item_quantity numeric,
  item_unit_price numeric,
  item_discount_percent numeric,
  item_tax_percent numeric,
  item_net_amount numeric,
  item_add_discount numeric DEFAULT 0,
  CONSTRAINT purchase_return_pkey PRIMARY KEY (id)
);
CREATE TABLE public.purchase_order (
  id text NOT NULL,
  order_no text NOT NULL UNIQUE,
  vendor_name text,
  date date,
  status text DEFAULT 'Active'::text,
  supply_status text DEFAULT '-'::text,
  vendor_address text,
  area_pin_code text,
  city_state text,
  email text,
  mobile text,
  validity_date text,
  price_list text,
  payment_terms text,
  buyer text,
  reference_number text,
  expected_delivery_date text,
  internal_notes text,
  remarks text,
  terms_and_conditions text,
  additional_notes text,
  gross_amount numeric DEFAULT 0,
  discount_amount numeric DEFAULT 0,
  tax_amount numeric DEFAULT 0,
  round_off_amount numeric DEFAULT 0,
  total_amount numeric DEFAULT 0,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT purchase_order_pkey PRIMARY KEY (id)
);
