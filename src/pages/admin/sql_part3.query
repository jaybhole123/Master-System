CREATE TABLE public.purchase_order_items (
  id text NOT NULL,
  purchase_order_id text,
  item_type text,
  item_code text,
  description text,
  quantity numeric DEFAULT 0,
  unit_price numeric DEFAULT 0,
  discount_percent numeric DEFAULT 0,
  tax_percent numeric DEFAULT 0,
  net_amount numeric DEFAULT 0,
  add_discount numeric DEFAULT 0,
  CONSTRAINT purchase_order_items_pkey PRIMARY KEY (id),
  CONSTRAINT purchase_order_items_purchase_order_id_fkey FOREIGN KEY (purchase_order_id) REFERENCES public.purchase_order(id)
);
CREATE TABLE public.purchase (
  id text NOT NULL,
  purchase_no text NOT NULL UNIQUE,
  vendor_name text,
  date date,
  status text DEFAULT 'Active'::text,
  payment_status text DEFAULT '-'::text,
  material_rcvd_date text,
  bill_no text,
  vendor_bill_no text,
  bill_date text,
  vendor_address text,
  area_pin_code text,
  city_state text,
  state text,
  email text,
  mobile text,
  validity_date text,
  price_list text,
  payment_terms text,
  internal_notes text,
  remarks text,
  terms_and_conditions text,
  gross_amount numeric DEFAULT 0,
  discount_amount numeric DEFAULT 0,
  tax_amount numeric DEFAULT 0,
  round_off_amount numeric DEFAULT 0,
  total_amount numeric DEFAULT 0,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT purchase_pkey PRIMARY KEY (id)
);
CREATE TABLE public.purchase_items (
  id text NOT NULL,
  purchase_id text,
  item_type text,
  item_code text,
  description text,
  quantity numeric DEFAULT 0,
  unit_price numeric DEFAULT 0,
  discount_percent numeric DEFAULT 0,
  tax_percent numeric DEFAULT 0,
  net_amount numeric DEFAULT 0,
  add_discount numeric DEFAULT 0,
  CONSTRAINT purchase_items_pkey PRIMARY KEY (id),
  CONSTRAINT purchase_items_purchase_id_fkey FOREIGN KEY (purchase_id) REFERENCES public.purchase(id)
);
CREATE TABLE public.quotation (
  id text NOT NULL,
  quotation_no text NOT NULL UNIQUE,
  customer_name text,
  date date,
  status text DEFAULT 'Active'::text,
  supply_status text DEFAULT '-'::text,
  details jsonb NOT NULL DEFAULT '{}'::jsonb,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  customer_address text,
  customer_area_pin_code text,
  customer_city_state text,
  customer_state text,
  customer_email text,
  customer_mobile text,
  validity_date text,
  price_list text,
  payment_terms text,
  gross_amount numeric DEFAULT 0,
  discount_amount numeric DEFAULT 0,
  tax_amount numeric DEFAULT 0,
  round_off_amount numeric DEFAULT 0,
  total_amount numeric DEFAULT 0,
  item_code text,
  item_description text,
  item_quantity numeric DEFAULT 0,
  item_unit_price numeric DEFAULT 0,
  item_discount_percent numeric DEFAULT 0,
  item_tax_percent numeric DEFAULT 0,
  item_net_amount numeric DEFAULT 0,
  item_add_discount numeric DEFAULT 0,
  type_of_quotation text,
  CONSTRAINT quotation_pkey PRIMARY KEY (id)
);
CREATE TABLE public.item (
  id bigint NOT NULL DEFAULT nextval('item_id_seq'::regclass),
  ItemCode text NOT NULL UNIQUE,
  ItemName text NOT NULL,
  ITMBrandName text,
  ItmQtyRate numeric,
  product_image_url text,
  stock numeric DEFAULT 0,
  remarks jsonb DEFAULT '[]'::jsonb,
  CONSTRAINT item_pkey PRIMARY KEY (id)
);
CREATE TABLE public.sales_person_master (
  id integer NOT NULL DEFAULT nextval('sales_person_master_id_seq'::regclass),
  sales_person character varying NOT NULL,
  sales_no character varying,
  mobile_number character varying,
  CONSTRAINT sales_person_master_pkey PRIMARY KEY (id)
);
CREATE TABLE public.stock_updater (
  ItemCode text NOT NULL,
  stock numeric,
  CONSTRAINT stock_updater_pkey PRIMARY KEY (ItemCode)
);
CREATE TABLE public.challan (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT timezone('utc'::text, now()),
  challan_no text,
  challan_date date,
  customer_name text,
  address text,
  order_no text,
  order_date date,
  through text,
  items jsonb,
  pipe text,
  box text,
  bag text,
  bdls text,
  total text,
  status text DEFAULT 'Active'::text,
  gstin text,
  CONSTRAINT challan_pkey PRIMARY KEY (id)
);
CREATE TABLE public.quotation_items (
  id text NOT NULL,
  quotation_id text,
  item_type text DEFAULT 'item'::text,
  item_code text,
  description text,
  quantity numeric DEFAULT 0,
  unit_price numeric DEFAULT 0,
  discount_percent numeric DEFAULT 0,
  tax_percent numeric DEFAULT 0,
  net_amount numeric DEFAULT 0,
  add_discount numeric DEFAULT 0,
  thumbnail text,
  CONSTRAINT quotation_items_pkey PRIMARY KEY (id),
  CONSTRAINT quotation_items_quotation_id_fkey FOREIGN KEY (quotation_id) REFERENCES public.quotation(id)
);