-- ==============================================================================
-- MIS SYSTEM - SUPABASE DATABASE SCHEMA & PAGE-WISE QUERIES
-- ==============================================================================
-- You can run these queries directly in Supabase -> SQL Editor.
-- Every section is organized page-by-page with CREATE TABLE, SAMPLE DATA, and SELECT/INSERT/UPDATE queries.
-- ==============================================================================


-- ==============================================================================
-- SECTION 0: BASE USERS TABLE (Used for Auth, Layout & Profile)
-- ==============================================================================

-- 0.1 Create Users Table
CREATE TABLE IF NOT EXISTS public.users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    username TEXT UNIQUE NOT NULL,
    password TEXT NOT NULL, -- In production, hash passwords or use Supabase Auth
    name TEXT NOT NULL,
    email TEXT UNIQUE,
    phone TEXT,
    department TEXT NOT NULL,
    designation TEXT NOT NULL,
    role TEXT NOT NULL DEFAULT 'user', -- 'admin', 'superadmin', 'hod', 'user'
    reported_by TEXT, -- Manager/HOD name or ID
    image_url TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- 0.2 Enable Row Level Security (RLS)
ALTER TABLE public.users ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Allow public read-write for demo" ON public.users FOR ALL USING (true);

-- 0.3 Sample Users Seed
INSERT INTO public.users (username, password, name, email, phone, department, designation, role, reported_by, image_url)
VALUES 
('admin', 'admin123', 'Administrator', 'admin@chemplast.com', '9876543210', 'Management', 'System Administrator', 'admin', '', 'https://ui-avatars.com/api/?name=Admin&background=0D8ABC&color=fff'),
('pratap', 'user123', 'Pratap Kumar', 'pratap@chemplast.com', '9876543211', 'Engineering', 'CRM', 'user', 'Administrator', 'https://images.pexels.com/photos/614810/pexels-photo-614810.jpeg?auto=compress&cs=tinysrgb&w=600'),
('chetan', 'user123', 'Chetan Sharma', 'chetan@chemplast.com', '9876543212', 'Design', 'PURCHASER', 'user', 'Administrator', 'https://images.pexels.com/photos/774909/pexels-photo-774909.jpeg?auto=compress&cs=tinysrgb&w=600'),
('digendra', 'user123', 'Digendra Patel', 'digendra@chemplast.com', '9876543213', 'Marketing', 'HR', 'hod', 'Administrator', 'https://images.pexels.com/photos/1222271/pexels-photo-1222271.jpeg?auto=compress&cs=tinysrgb&w=600')
ON CONFLICT (username) DO NOTHING;



-- ==============================================================================
-- SECTION 1: PAGE - DASHBOARD (/admin/dashboard)
-- ==============================================================================

-- 1.1 Create Current Week Employee Performance Table
CREATE TABLE IF NOT EXISTS public.dashboard_employee_performance (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    employee_id UUID REFERENCES public.users(id) ON DELETE CASCADE,
    employee_name TEXT NOT NULL,
    designation TEXT,
    department TEXT,
    image_url TEXT,
    date_start DATE NOT NULL,
    date_end DATE NOT NULL,
    target NUMERIC DEFAULT 100,
    actual_work_done NUMERIC DEFAULT 0,
    weekly_work_done_pct NUMERIC DEFAULT 0,
    weekly_work_done_on_time_pct NUMERIC DEFAULT 0,
    total_work_done NUMERIC DEFAULT 0,
    week_pending NUMERIC DEFAULT 0,
    all_pending_till_date NUMERIC DEFAULT 0,
    planned_work_not_done NUMERIC DEFAULT 0,
    planned_work_not_done_on_time NUMERIC DEFAULT 0,
    last_week_commitment NUMERIC DEFAULT 0,
    next_week_planned_not_done NUMERIC DEFAULT 0,
    next_week_planned_not_done_on_time NUMERIC DEFAULT 0,
    next_week_commitment NUMERIC DEFAULT 0,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- 1.2 Create Department Scores Table (For Dashboard Graph)
CREATE TABLE IF NOT EXISTS public.department_scores (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    department_name TEXT UNIQUE NOT NULL,
    work_not_done_pct NUMERIC DEFAULT 0,
    not_done_on_time_pct NUMERIC DEFAULT 0,
    pending_works INTEGER DEFAULT 0,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- 1.3 Sample Seed Data for Dashboard
INSERT INTO public.department_scores (department_name, work_not_done_pct, not_done_on_time_pct, pending_works)
VALUES 
('Engineering', 12.5, 8.0, 5),
('Design', 15.0, 10.2, 4),
('Marketing', 9.8, 6.4, 3),
('Sales', 18.2, 12.0, 6),
('Operations', 14.0, 9.5, 4)
ON CONFLICT (department_name) DO UPDATE 
SET work_not_done_pct = EXCLUDED.work_not_done_pct,
    not_done_on_time_pct = EXCLUDED.not_done_on_time_pct,
    pending_works = EXCLUDED.pending_works;

