-- ==============================================================================
-- SECTION 3: PAGE - KPI & KRA (/admin/kpi-kra)
-- ==============================================================================

-- 3.1 Create KPI/KRA Role Details Table
CREATE TABLE IF NOT EXISTS public.kpi_kra_roles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    designation TEXT UNIQUE NOT NULL, -- CRM, PURCHASER, HR, EA, SALES, etc.
    actual_role_summary TEXT,
    total_daily_tasks_text TEXT DEFAULT '5 daily tasks',
    communication_team TEXT,
    key_person TEXT,
    how_to_communicate TEXT,
    youtube_link TEXT,
    instagram_link TEXT,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- 3.2 Create KPI/KRA Systems & Resources Table
CREATE TABLE IF NOT EXISTS public.kpi_kra_systems (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    designation TEXT NOT NULL, -- References designation or 'All'
    system_name TEXT NOT NULL,
    task_name TEXT NOT NULL,
    description TEXT,
    system_link TEXT,
    db_link TEXT,
    training_video TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
);

