-- ==============================================================================
-- SECTION 4: PAGE - TODAY'S TASKS (/admin/today-tasks)
-- ==============================================================================

-- 4.1 Create Today's Tasks Table
CREATE TABLE IF NOT EXISTS public.tasks (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    employee_id UUID REFERENCES public.users(id) ON DELETE SET NULL,
    person_name TEXT NOT NULL,
    department TEXT,
    designation TEXT,
    fms_name TEXT NOT NULL, -- e.g. "Gate Entry FMS", "Project Alpha"
    task_name TEXT NOT NULL,
    description TEXT,
    planned_date DATE NOT NULL,
    planned_time TIME,
    actual_date DATE,
    actual_time TIME,
    delay_duration TEXT,
    status TEXT DEFAULT 'pending', -- 'completed', 'in-progress', 'pending', 'delayed'
    priority TEXT DEFAULT 'medium', -- 'high', 'medium', 'low'
    created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- 4.2 Sample Seed Data for Tasks
