('Digendra Patel', 'HR', 'Marketing', 'https://images.pexels.com/photos/1222271/pexels-photo-1222271.jpeg?auto=compress&cs=tinysrgb&w=600', '2025-05-01', '2025-05-07', 90, 81, 90.0, 92.0, 90, 1, 3, 8.0, 5.0, 92, 7, 4, 94);

